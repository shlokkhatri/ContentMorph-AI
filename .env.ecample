# Copy this file to ".env" in the same folder and fill in your real values.
# ".env" is git-ignored, so your secrets never get committed.

# Required. Get your key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Which Claude model to use for generation.
CLAUDE_MODEL=claude-sonnet-5

# PostgreSQL connection string: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/content_platform

# URL where the React frontend runs (needed so the browser is allowed to call this API)
FRONTEND_ORIGIN=http://localhost:5173